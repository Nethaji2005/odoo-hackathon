# Dayflow Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit the real .env file.

PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string_here
JWT_SECRET=your_jwt_secret_here_min_32_chars
NODE_ENV=development

# -----------------------------------------------
# AUTH MODULE CONTRACT (Member 1 integration)
# -----------------------------------------------
# The requireAuth middleware in src/middleware/auth.js
# expects a JWT signed with JWT_SECRET that encodes:
#
#   { id: "<mongodb_user_id>", role: "employee" | "admin" | "hr" }
#
# Member 1 must sign tokens with this shape so that
# Employee Profile + Payroll authorization works correctly.
# -----------------------------------------------
