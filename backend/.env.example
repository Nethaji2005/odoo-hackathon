# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Replace <username>, <password>, and <cluster> with your Atlas credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dayflow?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Use a long, random secret (e.g., generated with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Origin of the React/Vite frontend. Used to configure Express CORS.
# Default fallback (if omitted in development): http://localhost:5173
FRONTEND_URL=http://localhost:5173
